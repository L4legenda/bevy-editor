# Rust build output (including auxiliary crates).
target/
*.exe
*.dll
*.pdb
*.rlib
*.rmeta
*.ilk
*.o
*.rs.bk

# Generated release and coverage output.
/dist/
/coverage/
/release-notes.md
*.profraw
*.profdata

# Local edits to the bundled example scenes.
/examples/assets/levels/

# Local editor preferences and session trash within asset roots.
**/.bevy-editor/
**/.bevy-editor-trash/
**/.bevy-editor-move-*
# Keep .bevy-editor-asset-moves.json: projects need it to resolve moved assets.

# Temporary files, editor backups and Python asset-generator caches.
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Machine-specific IDE settings and local environment variables.
.idea/
.vscode/
.vs/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Runtime and tool logs.
*.log
*.log.*

# Operating-system metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini
